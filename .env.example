APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

FACTURACION_MAIL_PROVIDER=laravel
FACTURACION_MAIL_MAILER=facturas
FACTURACION_MAIL_HOST=mail.riveraco.com.mx
FACTURACION_MAIL_PORT=465
FACTURACION_MAIL_USERNAME=noreply@riveraco.com.mx
FACTURACION_MAIL_PASSWORD=
FACTURACION_MAIL_ENCRYPTION=ssl
FACTURACION_MAIL_FROM_ADDRESS=noreply@riveraco.com.mx
FACTURACION_MAIL_FROM_NAME="Rivera Construcciones"
FACTURACION_GRAPH_TENANT_ID=
FACTURACION_GRAPH_CLIENT_ID=
FACTURACION_GRAPH_CLIENT_SECRET=
FACTURACION_GRAPH_USER=administracion@riveraco.com.mx

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
# Grandstream UCM6304A / telefonia
GRANDSTREAM_ENABLED=false
GRANDSTREAM_BASE_URL=
GRANDSTREAM_API_PATH=/api
GRANDSTREAM_USERNAME=
GRANDSTREAM_PASSWORD=
GRANDSTREAM_API_VERSION=1.0
GRANDSTREAM_VERIFY_TLS=true
GRANDSTREAM_TIMEOUT=15
GRANDSTREAM_CONNECT_TIMEOUT=5
GRANDSTREAM_MODE=local
GRANDSTREAM_CDR_PAGE_SIZE=100
GRANDSTREAM_CDR_PADDING_HOURS=12
GRANDSTREAM_TIMEZONE=America/Mexico_City
GRANDSTREAM_CDR_FORMAT=json
# Grandstream local agent -> production SIRICO
# On production set GRANDSTREAM_MODE=agent so Bluehost does not call the UCM directly.
GRANDSTREAM_AGENT_SERVER_URL=
GRANDSTREAM_AGENT_TOKEN=
GRANDSTREAM_AGENT_EMAIL=
GRANDSTREAM_AGENT_PASSWORD=
GRANDSTREAM_AGENT_TIMEOUT=30
